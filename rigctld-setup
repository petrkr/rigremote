#!/bin/bash
#
# rigctld-setup - Setup script for rigctld service
# Creates configuration file for a specific radio based on USB serial number
#

set -e

CONFIG_DIR="/etc/default"
DEFAULT_TCP_PORT="4532"
DEFAULT_LISTEN_ADDR="ANY"

echo "=== rigctld Setup ==="
echo ""
echo "Scanning for available USB serial devices..."
echo ""

# Find CP2105 devices (Silicon Labs)
found=0
declare -A devices

for dev in /dev/ttyUSB*; do
    [ -e "$dev" ] || continue

    serial=$(udevadm info -q property "$dev" 2>/dev/null | grep "^ID_SERIAL_SHORT=" | cut -d= -f2)
    vendor=$(udevadm info -q property "$dev" 2>/dev/null | grep "^ID_VENDOR_ID=" | cut -d= -f2)
    model=$(udevadm info -q property "$dev" 2>/dev/null | grep "^ID_MODEL_ID=" | cut -d= -f2)
    model_name=$(udevadm info -q property "$dev" 2>/dev/null | grep "^ID_MODEL=" | cut -d= -f2)

    if [ -n "$serial" ]; then
        found=$((found + 1))
        devices["$serial"]="$dev"

        config_status="(no config)"
        if [ -f "${CONFIG_DIR}/rigctld.${serial}" ]; then
            config_status="(configured)"
        fi

        echo "  [$found] $dev"
        echo "      Serial:  $serial $config_status"
        echo "      Model:   $model_name (${vendor}:${model})"
        echo ""
    fi
done

if [ $found -eq 0 ]; then
    echo "No USB serial devices found."
    echo "Make sure your radio interface is connected."
    exit 1
fi

echo "---"
echo ""
read -p "Enter serial number to configure: " SERIAL

if [ -z "$SERIAL" ]; then
    echo "Error: No serial number provided."
    exit 1
fi

# Check if device exists
if [ -z "${devices[$SERIAL]}" ]; then
    echo "Warning: Device with serial '$SERIAL' not currently connected."
    read -p "Continue anyway? [y/N]: " confirm
    if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
        exit 1
    fi
fi

echo ""
echo "Enter Hamlib RIG_ID (model number)."
echo "  1020 - Yaesu FT-817"
echo "  1035 - Yaesu FT-991"
echo "  1041 - Yaesu FT-818"
echo ""
echo "Run 'rigctld -l' for full list of supported radios."
echo ""
read -p "RIG_ID: " RIG_ID

if [ -z "$RIG_ID" ]; then
    echo "Error: No RIG_ID provided."
    exit 1
fi

# Validate RIG_ID is a number
if ! [[ "$RIG_ID" =~ ^[0-9]+$ ]]; then
    echo "Error: RIG_ID must be a number."
    exit 1
fi

echo ""
read -p "TCP_PORT [$DEFAULT_TCP_PORT]: " TCP_PORT
TCP_PORT="${TCP_PORT:-$DEFAULT_TCP_PORT}"

if ! [[ "$TCP_PORT" =~ ^[0-9]+$ ]]; then
    echo "Error: TCP_PORT must be a number."
    exit 1
fi

echo ""
read -p "LISTEN_ADDR [$DEFAULT_LISTEN_ADDR]: " LISTEN_ADDR
LISTEN_ADDR="${LISTEN_ADDR:-$DEFAULT_LISTEN_ADDR}"

CONFIG_FILE="${CONFIG_DIR}/rigctld.${SERIAL}"

echo ""
echo "Configuration:"
echo "  Serial:  $SERIAL"
echo "  RIG_ID:  $RIG_ID"
echo "  Device:  /dev/rig_${SERIAL}"
echo "  TCP:     ${LISTEN_ADDR}:${TCP_PORT}"
echo "  Config:  $CONFIG_FILE"
echo ""

read -p "Create configuration? [Y/n]: " confirm
if [ "$confirm" = "n" ] || [ "$confirm" = "N" ]; then
    echo "Aborted."
    exit 1
fi

# Create config file
cat > "$CONFIG_FILE" << EOF
# rigctld configuration for serial $SERIAL
# Generated by rigctld-setup on $(date)
RIG_ID=$RIG_ID
RIG_DEVICE=/dev/rig_$SERIAL
TCP_PORT=$TCP_PORT
LISTEN_ADDR=$LISTEN_ADDR
EOF

echo "Configuration saved to $CONFIG_FILE"

# Enable service
echo ""
read -p "Enable rigctld@${SERIAL}.service? [Y/n]: " enable
if [ "$enable" != "n" ] && [ "$enable" != "N" ]; then
    systemctl enable "rigctld@${SERIAL}.service"
    echo "Service enabled."

    # Start if device is connected
    if [ -e "/dev/rig_${SERIAL}" ] || [ -n "${devices[$SERIAL]}" ]; then
        read -p "Start service now? [Y/n]: " start
        if [ "$start" != "n" ] && [ "$start" != "N" ]; then
            systemctl start "rigctld@${SERIAL}.service"
            echo "Service started."
        fi
    fi
fi

echo ""
echo "Setup complete!"
echo ""
echo "The rigctld service will automatically start when the device is connected"
echo "and stop when disconnected (requires udev rules in /etc/udev/rules.d/)."
