# Udev rules for automatic rigctld service management
# Install to: /etc/udev/rules.d/99-rigctld.rules
#
# This rule handles supported USB serial adapters commonly used in HAM radio interfaces
# Adjust ID_VENDOR_ID and ID_MODEL_ID for other USB serial adapters
#
# When a matching device is connected:
#   - Creates symlink /dev/rig_<SERIAL> for consistent device naming
#   - Starts rigctld@<SERIAL>.service (only if /etc/default/rigctld.<SERIAL> exists)
#
# When device is disconnected:
#   - Stops the corresponding rigctld service

# CP2105 Silicon Labs - connect: create symlink and start service
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="10c4", ENV{ID_MODEL_ID}=="ea70", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="rig_%E{ID_SERIAL_SHORT}", TAG+="systemd", ENV{SYSTEMD_WANTS}="rigctld@%E{ID_SERIAL_SHORT}.service"

# CP2105 Silicon Labs - disconnect: stop service
ACTION=="remove", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="10c4", ENV{ID_MODEL_ID}=="ea70", ENV{ID_USB_INTERFACE_NUM}=="00", RUN+="/bin/systemctl stop rigctld@%E{ID_SERIAL_SHORT}.service"

# Prolific PL2303 - connect: create symlink and start service
ACTION=="add", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="067b", ENV{ID_MODEL_ID}=="23a3", SYMLINK+="rig_%E{ID_SERIAL_SHORT}", TAG+="systemd", ENV{SYSTEMD_WANTS}="rigctld@%E{ID_SERIAL_SHORT}.service"

# Prolific PL2303 - disconnect: stop service
ACTION=="remove", SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="067b", ENV{ID_MODEL_ID}=="23a3", RUN+="/bin/systemctl stop rigctld@%E{ID_SERIAL_SHORT}.service"

# CM108 C-Media USB audio PTT - connect: create fixed symlink and start service
ACTION=="add", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0d8c", ATTRS{idProduct}=="0012", GROUP="audio", MODE="0660", SYMLINK+="rigptt.cm0", TAG+="systemd", ENV{SYSTEMD_WANTS}="rigctld@cm0.service"

# CM108 C-Media USB audio PTT - disconnect: stop service
ACTION=="remove", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0d8c", ATTRS{idProduct}=="0012", RUN+="/bin/systemctl stop rigctld@cm0.service"
